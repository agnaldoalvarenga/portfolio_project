NODE_ENV=development
# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=change_me_min_16_chars
WHATSAPP_APP_SECRET=change_me_min_16_chars
WHATSAPP_ACCESS_TOKEN=EAAG...your_token
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_GRAPH_VERSION=v21.0
# --- n8n orchestration (private network) ---
N8N_INBOUND_WEBHOOK_URL=https://n8n.internal/webhook/ostentaculus-inbound
N8N_SHARED_SECRET=change_me_min_32_chars_xxxxxxxxxx
# --- internal service auth (n8n -> tRPC) ---
CONCIERGE_SERVICE_TOKEN=change_me_min_32_chars_xxxxxxxxxx
# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxx
CLAUDE_MODEL=claude-opus-4-8
# --- Google Maps (server-side only) ---
GOOGLE_MAPS_API_KEY=
# --- Field-level encryption (AES-256-GCM). Generate: ---
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# --- Supabase ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ostentaculus
SUPABASE_URL=
SUPABASE_ANON_KEY=
# --- FASE 3: lead pseudonymization salt (stable; >=16 chars) ---
LEAD_PSEUDONYM_SALT=change_me_min_16_chars
# --- FASE 6: YouTube Data API v3 (audience intelligence + metadata) ---
YOUTUBE_API_KEY=
# --- FASE 5: Stripe (Billing + Connect). Optional until billing is used. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
ROUTE_COMMISSION_PCT=15
